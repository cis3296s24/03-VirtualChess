<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="piece" alignment="CENTER" spacing="14.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="810.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cis3296.virtualchess.Controller.PieceTutorialController">
    <padding>
        <Insets bottom="12.0" top="12.0" />
    </padding>
    <!-- Up to three pictures with a text card underneath (these topics have longer text). Fixed height so the
         buttons don't move between topics; sized to fit the longest description (Stalemate). -->
    <VBox alignment="TOP_CENTER" spacing="12.0" minHeight="450.0" prefHeight="450.0" maxHeight="450.0">
        <HBox alignment="CENTER" spacing="10.0">
            <ImageView fx:id="imageView" fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fx:id="additionalImageView" fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fx:id="additionalImageView2" fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
        </HBox>
        <VBox styleClass="tutorial-card" minWidth="760.0" prefWidth="760.0" maxWidth="760.0" VBox.vgrow="ALWAYS">
            <Label fx:id="topicTitle" styleClass="tutorial-title" text="Check and Checkmate" />
            <Label fx:id="descriptionLabel" styleClass="tutorial-text" maxWidth="Infinity" minHeight="-Infinity" text="Pick a topic below to learn about check, checkmate, and stalemate." />
        </VBox>
    </VBox>
    <VBox alignment="CENTER" spacing="8.0">
        <Button mnemonicParsing="false" onAction="#switchToCheck" prefHeight="54.0" prefWidth="355.0" text="What is Check?" />
        <Button mnemonicParsing="false" onAction="#switchToGettingOutofCheck" prefHeight="54.0" prefWidth="355.0" text="Getting Out of Check" />
        <Button mnemonicParsing="false" onAction="#switchToCheckMate" prefHeight="54.0" prefWidth="355.0" text="Checkmate" />
        <Button mnemonicParsing="false" onAction="#switchToStalemate" prefHeight="54.0" prefWidth="355.0" text="Stalemate" />
    </VBox>
    <Button styleClass="secondary" mnemonicParsing="false" onAction="#switchToTutorial" prefHeight="54.0" prefWidth="355.0" text="Back" />
</VBox>
