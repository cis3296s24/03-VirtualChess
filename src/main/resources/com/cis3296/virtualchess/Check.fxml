<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="piece" alignment="CENTER" spacing="20.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="810.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cis3296.virtualchess.Controller.PieceTutorialController">
    <padding>
        <Insets bottom="10.0" top="10.0" />
    </padding>
    <!-- Up to three pictures with the description underneath (these topics have longer text). Fixed height so the
         buttons don't move when a topic is picked; sized to fit the longest description (Stalemate). -->
    <VBox alignment="TOP_CENTER" spacing="10.0" minHeight="420.0" prefHeight="420.0" maxHeight="420.0">
        <HBox alignment="CENTER" spacing="10.0">
            <ImageView fx:id="imageView" fitHeight="160.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fx:id="additionalImageView" fitHeight="160.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fx:id="additionalImageView2" fitHeight="160.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true" />
        </HBox>
        <Label fx:id="descriptionLabel" maxWidth="760.0" style="-fx-font-family: 'Calibri'; -fx-font-size: 14px;" textFill="WHITE" wrapText="true" />
    </VBox>
    <VBox alignment="CENTER" spacing="8.0">
        <Button mnemonicParsing="false" onAction="#switchToCheck" prefHeight="58.0" prefWidth="355.0" text="What is Check?" />
        <Button mnemonicParsing="false" onAction="#switchToGettingOutofCheck" prefHeight="58.0" prefWidth="355.0" text="Getting Out of Check" />
        <Button mnemonicParsing="false" onAction="#switchToCheckMate" prefHeight="58.0" prefWidth="355.0" text="Checkmate" />
        <Button mnemonicParsing="false" onAction="#switchToStalemate" prefHeight="58.0" prefWidth="355.0" text="Stalemate" />
    </VBox>
    <Button mnemonicParsing="false" onAction="#switchToTutorial" prefHeight="58.0" prefWidth="355.0" text="Back" />
</VBox>
