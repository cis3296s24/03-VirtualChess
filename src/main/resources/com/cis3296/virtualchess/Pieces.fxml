<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="piece" alignment="CENTER" spacing="20.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="810.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cis3296.virtualchess.Controller.PieceTutorialController">
    <padding>
        <Insets bottom="20.0" top="20.0" />
    </padding>
    <!-- Pictures and a text card, centered as a group. Fixed height so the buttons don't move between topics. -->
    <HBox alignment="CENTER" spacing="12.0" minHeight="290.0" prefHeight="290.0" maxHeight="290.0">
        <ImageView fx:id="imageView" fitHeight="210.0" fitWidth="210.0" pickOnBounds="true" preserveRatio="true" />
        <ImageView fx:id="additionalImageView" fitHeight="210.0" fitWidth="210.0" pickOnBounds="true" preserveRatio="true" />
        <VBox styleClass="tutorial-card" minWidth="310.0" prefWidth="310.0" maxWidth="310.0">
            <Label fx:id="topicTitle" styleClass="tutorial-title" text="The Pieces" />
            <Label fx:id="descriptionLabel" styleClass="tutorial-text" maxWidth="Infinity" minHeight="-Infinity" text="Pick a piece below to see how it moves." />
        </VBox>
    </HBox>
    <VBox alignment="CENTER" spacing="8.0">
        <Button mnemonicParsing="false" onAction="#switchToPawn" prefHeight="54.0" prefWidth="355.0" text="Pawn" />
        <Button mnemonicParsing="false" onAction="#switchToRook" prefHeight="54.0" prefWidth="355.0" text="Rook" />
        <Button mnemonicParsing="false" onAction="#switchToBishop" prefHeight="54.0" prefWidth="355.0" text="Bishop" />
        <Button mnemonicParsing="false" onAction="#switchToKnight" prefHeight="54.0" prefWidth="355.0" text="Knight" />
        <Button mnemonicParsing="false" onAction="#switchToKing" prefHeight="54.0" prefWidth="355.0" text="King" />
        <Button mnemonicParsing="false" onAction="#switchToQueen" prefHeight="54.0" prefWidth="355.0" text="Queen" />
    </VBox>
    <Button styleClass="secondary" mnemonicParsing="false" onAction="#switchToTutorial" prefHeight="54.0" prefWidth="355.0" text="Back" />
</VBox>
