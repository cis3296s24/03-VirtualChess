<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="piece" alignment="CENTER" spacing="20.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="810.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cis3296.virtualchess.Controller.PieceTutorialController">
    <padding>
        <Insets bottom="20.0" top="20.0" />
    </padding>
    <!-- Picture and a text card, centered as a group. Fixed height so the buttons don't move between topics. -->
    <HBox alignment="CENTER" spacing="12.0" minHeight="340.0" prefHeight="340.0" maxHeight="340.0">
        <ImageView fx:id="imageView" fitHeight="250.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" />
        <VBox styleClass="tutorial-card" minWidth="480.0" prefWidth="480.0" maxWidth="480.0">
            <Label fx:id="topicTitle" styleClass="tutorial-title" text="Special Moves" />
            <Label fx:id="descriptionLabel" styleClass="tutorial-text" maxWidth="Infinity" minHeight="-Infinity" text="Pick a special move below to see how it works." />
        </VBox>
    </HBox>
    <VBox alignment="CENTER" spacing="8.0">
        <Button mnemonicParsing="false" onAction="#switchToCastling" prefHeight="54.0" prefWidth="355.0" text="Castling" />
        <Button mnemonicParsing="false" onAction="#switchToPromotion" prefHeight="54.0" prefWidth="355.0" text="Promotion" />
        <Button mnemonicParsing="false" onAction="#switchToEnPassant" prefHeight="54.0" prefWidth="355.0" text="En Passant" />
    </VBox>
    <Button styleClass="secondary" mnemonicParsing="false" onAction="#switchToTutorial" prefHeight="54.0" prefWidth="355.0" text="Back" />
</VBox>
