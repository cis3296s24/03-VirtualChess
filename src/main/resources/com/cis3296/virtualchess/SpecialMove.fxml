<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="piece" alignment="CENTER" spacing="20.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="810.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cis3296.virtualchess.Controller.PieceTutorialController">
    <padding>
        <Insets bottom="20.0" top="20.0" />
    </padding>
    <!-- Picture and description, centered as a group. Fixed height so the buttons don't move when a topic is picked. -->
    <HBox alignment="CENTER" spacing="10.0" minHeight="250.0" prefHeight="250.0" maxHeight="250.0">
        <ImageView fx:id="imageView" fitHeight="250.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" />
        <Label fx:id="descriptionLabel" minWidth="300.0" prefWidth="300.0" maxWidth="300.0" style="-fx-font-family: 'Calibri'; -fx-font-size: 14px;" textFill="WHITE" wrapText="true" />
    </HBox>
    <VBox alignment="CENTER" spacing="8.0">
        <Button mnemonicParsing="false" onAction="#switchToCastling" prefHeight="58.0" prefWidth="355.0" text="Castling" />
        <Button mnemonicParsing="false" onAction="#switchToPromotion" prefHeight="58.0" prefWidth="355.0" text="Promotion" />
        <Button mnemonicParsing="false" onAction="#switchToEnPassant" prefHeight="58.0" prefWidth="355.0" text="En Passant" />
    </VBox>
    <Button mnemonicParsing="false" onAction="#switchToTutorial" prefHeight="58.0" prefWidth="355.0" text="Back" />
</VBox>
