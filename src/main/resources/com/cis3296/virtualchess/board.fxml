<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<!-- Colors come from the chosen board theme: GameController sets -theme-light and -theme-dark on this root
     (see menuStyle.css, "Game screen"). -->
<HBox fx:id="gameScreen" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cis3296.virtualchess.Controller.GameController">
    <!-- GameController puts the BoardView in here. (FXML can't import it directly: the loader treats the
         capitalized "Components" package as a class name.) -->
    <StackPane fx:id="boardContainer" />
    <VBox styleClass="side-panel" minWidth="300.0" prefWidth="300.0" maxWidth="300.0">
        <Text fx:id="currentTurnText" styleClass="turn-text" text="Current Turn:" textAlignment="CENTER" wrappingWidth="268.0" />
        <VBox styleClass="clock-box">
            <Text fx:id="timerTextWhite" styleClass="clock-text" text="White Time:" />
            <Text fx:id="timerTextBlack" styleClass="clock-text" text="Black Time:" />
        </VBox>
        <!-- Small preferred height so the list just fills the space left over (the default is 400px, which made
             the panel taller than the 800px board) -->
        <ListView fx:id="moveList" focusTraversable="false" prefHeight="100.0" VBox.vgrow="ALWAYS" />
        <Button fx:id="undo" maxWidth="Infinity" mnemonicParsing="false" onAction="#undoMoveButton" prefHeight="46.0" text="Undo Move" />
        <Button fx:id="resign" styleClass="secondary" maxWidth="Infinity" mnemonicParsing="false" onAction="#resignButton" prefHeight="46.0" text="Resign" />
        <Button styleClass="secondary" maxWidth="Infinity" mnemonicParsing="false" onAction="#settings" prefHeight="46.0" text="Settings" />
        <Button styleClass="secondary" maxWidth="Infinity" mnemonicParsing="false" onAction="#leaveGame" prefHeight="46.0" text="End Game" />
    </VBox>
</HBox>
