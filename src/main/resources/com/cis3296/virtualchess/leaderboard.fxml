<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<!-- The table takes the chosen board theme's colors: LeaderBoardController sets -theme-light and -theme-dark
     on this root (see menuStyle.css, "Leaderboard"). -->
<VBox fx:id="menu" alignment="CENTER" spacing="12.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="810.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cis3296.virtualchess.Controller.LeaderBoardController">
    <padding>
        <Insets bottom="30.0" top="30.0" />
    </padding>
    <Label styleClass="screen-title" text="Leaderboard" />
    <Label styleClass="screen-subtitle" text="Results of every finished game." />
    <TableView fx:id="table" minWidth="700.0" prefWidth="700.0" maxWidth="700.0" prefHeight="520.0">
        <VBox.margin>
            <Insets bottom="12.0" top="12.0" />
        </VBox.margin>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
        </columnResizePolicy>
        <placeholder>
            <Label text="No games played yet. Finish a game to see it here!" />
        </placeholder>
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="60.0" text="#" />
            <TableColumn fx:id="Player1Column" prefWidth="200.0" text="White" />
            <TableColumn fx:id="Player1ResultColumn" prefWidth="110.0" text="Result" />
            <TableColumn fx:id="Player2Column" prefWidth="200.0" text="Black" />
            <TableColumn fx:id="Player2ResultColumn" prefWidth="110.0" text="Result" />
        </columns>
    </TableView>
    <Button fx:id="backButton" styleClass="secondary" mnemonicParsing="false" onAction="#backToMainMenu" prefHeight="54.0" prefWidth="355.0" text="Back" />
</VBox>
