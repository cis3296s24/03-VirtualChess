<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="menu" alignment="CENTER" spacing="12.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="810.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cis3296.virtualchess.Controller.PlayerSelectionScreenController">
    <Label styleClass="screen-title" text="Play the Computer" />
    <Label styleClass="screen-subtitle" text="You play White against Stockfish." />
    <VBox styleClass="card" spacing="16.0" minWidth="440.0" prefWidth="440.0" maxWidth="440.0">
        <VBox.margin>
            <Insets top="24.0" />
        </VBox.margin>
        <VBox spacing="6.0">
            <Label styleClass="field-label" text="Your name" />
            <TextField fx:id="player1name" promptText="Name" />
        </VBox>
        <VBox spacing="6.0">
            <Label styleClass="field-label" text="Minutes per player" />
            <TextField fx:id="timer" promptText="5" />
            <Label styleClass="hint-text" text="Leave blank for 5 minutes each." />
        </VBox>
        <Label fx:id="errorLabel" styleClass="error-label" managed="false" visible="false" wrapText="true" maxWidth="Infinity" />
    </VBox>
    <Button defaultButton="true" mnemonicParsing="false" onAction="#switchToGame" prefHeight="54.0" prefWidth="355.0" text="Start Game">
        <VBox.margin>
            <Insets top="20.0" />
        </VBox.margin>
    </Button>
    <Button styleClass="secondary" mnemonicParsing="false" onAction="#switchToGamemode" prefHeight="54.0" prefWidth="355.0" text="Back" />
</VBox>
